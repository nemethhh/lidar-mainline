/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Amazon Echo Plus (2nd generation), "lidar".
 *
 * U-Boot is the payload of an Android boot image in boot_a/boot_b (loaded by
 * Amazon LK). The operating system lives in ext4 filesystems on the GPT
 * partitions system_a and system_b and is described by
 * /boot/extlinux/extlinux.conf on each.
 *
 * A/B with automatic fallback (U-Boot bootcount stored in this environment,
 * at the top of the "misc" partition):
 *   - lidar_slot selects system_a or system_b.
 *   - An updater writes the inactive slot, then sets
 *       lidar_slot=<new> upgrade_available=1 bootcount=0
 *     (fw_setenv, see README.md at the top of the repository) and reboots.
 *   - While upgrade_available=1 every boot increments bootcount; past
 *     bootlimit U-Boot runs altbootcmd, which flips back to the other slot.
 *   - Userspace confirms a good boot with
 *       fw_setenv upgrade_available 0; fw_setenv bootcount 0
 *
 * Holding Volume Up at power-on enters USB fastboot (pogo-pin USB).
 * Holding Action is consumed earlier by Kaeru LK for its own fastboot.
 */

kernel_addr_r=0x44000000
kernel_comp_addr_r=0x50000000
kernel_comp_size=0x04000000
fdt_addr_r=0x4f000000
fdtoverlay_addr_r=0x4f100000
/* LK's devicetree (read for IDME) sits at 0x4e000000-0x4e080000: keep it free */
pxefile_addr_r=0x4e100000
ramdisk_addr_r=0x54000000

fdtfile=mediatek/mt8516-amazon-lidar.dtb

lidar_slot=a
bootlimit=3
upgrade_available=0

lidar_fastboot=echo "lidar: entering USB fastboot"; fastboot usb 0

lidar_boot_slot=
	if part number mmc 0 system_${lidar_slot} lidar_part; then
		echo "lidar: booting slot ${lidar_slot} (mmc 0:${lidar_part})";
		sysboot mmc 0:${lidar_part} any ${pxefile_addr_r}
			/boot/extlinux/extlinux.conf;
	fi;
	echo "lidar: slot ${lidar_slot} did not boot"

lidar_other_slot=
	if test "${lidar_slot}" = "a"; then
		setenv lidar_slot b;
	else
		setenv lidar_slot a;
	fi

bootcmd=
	if button volume_up; then
		run lidar_fastboot;
	fi;
	run lidar_boot_slot;
	run lidar_other_slot;
	run lidar_boot_slot;
	run lidar_fastboot

altbootcmd=
	echo "lidar: slot ${lidar_slot} exceeded bootlimit, falling back";
	run lidar_other_slot;
	setenv upgrade_available 0;
	setenv bootcount 0;
	saveenv;
	run bootcmd
