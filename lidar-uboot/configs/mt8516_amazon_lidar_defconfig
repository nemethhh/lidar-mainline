CONFIG_ARM=y
CONFIG_COUNTER_FREQUENCY=13000000
CONFIG_ARCH_MEDIATEK=y
CONFIG_TEXT_BASE=0x40080000
CONFIG_SYS_MALLOC_F_LEN=0x4000
# fastboot sparse images allocate chunk buffers on the heap
CONFIG_SYS_MALLOC_LEN=0x2000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x1970000
CONFIG_DM_GPIO=y
CONFIG_DEFAULT_DEVICE_TREE="mt8516-amazon-lidar"
CONFIG_TARGET_MT8516=y
CONFIG_MTK_MEM_MAP_DDR_SIZE=0x3f9c0000
CONFIG_MTK_LK_CHAINLOAD=y
CONFIG_MTK_AMAZON_IDME=y
CONFIG_SYS_LOAD_ADDR=0x44000000
CONFIG_ENV_OFFSET_REDUND=0x1960000
CONFIG_DEBUG_UART_BASE=0x11005000
CONFIG_DEBUG_UART_CLOCK=26000000
CONFIG_IDENT_STRING=" lidar"
CONFIG_DEBUG_UART=y
CONFIG_FIT=y
# No autoboot wait: Volume Up at power-on is the way into fastboot. A saved
# environment keeps its own bootdelay (installed units: fw_setenv bootdelay 0).
CONFIG_BOOTDELAY=0
# Keyed, so a byte of noise on the usually unwired, floating UART RX pad can
# never stop autoboot. With no delay the string cannot be typed in time
# either; "setenv bootdelay 3" brings the window back for UART work.
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Autoboot in %d s, type 'lidar' to stop\n"
CONFIG_AUTOBOOT_STOP_STR="lidar"
CONFIG_CONSOLE_RECORD=y
# Boot timing (counter since reset) handed to Linux in /bootstage of the DT;
# bootm only adds it with CMD_FDT
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
CONFIG_CMD_FDT=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_DEFAULT_FDT_FILE="mediatek/mt8516-amazon-lidar.dtb"
# extlinux initrd is a plain gzip cpio, not a legacy uImage
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_SYS_CBSIZE=1024
CONFIG_SYS_PBSIZE=1048
# CONFIG_BOARD_INIT is not set
CONFIG_BOARD_LATE_INIT=y
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_GPT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_FASTBOOT=y
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
# CONFIG_DOS_PARTITION is not set
CONFIG_ENV_SOURCE_FILE="amazon_lidar"
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_RELOC_GD_ENV_ADDR=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_MMC_USE_SW_PARTITION=y
CONFIG_ENV_MMC_SW_PARTITION="misc"
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BUTTON=y
CONFIG_BUTTON_GPIO=y
CONFIG_CLK=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x60100000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
# CONFIG_FASTBOOT_MMC_BOOT_SUPPORT is not set
# CONFIG_FASTBOOT_MMC_USER_SUPPORT is not set
# No UART input needed: `fastboot oem run:<cmd>` runs a U-Boot command and
# `fastboot oem console` returns its output over USB.
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
# CONFIG_INPUT is not set
# CONFIG_MMC_QUIRKS is not set
CONFIG_MMC_MTK=y
# DMA transfers time out after 5 s: at most 4 MB per command
CONFIG_SYS_MMC_MAX_BLK_COUNT=8192
CONFIG_PINCTRL=y
CONFIG_PINCONF=y
CONFIG_PINCTRL_MT8516=y
CONFIG_RAM=y
CONFIG_BAUDRATE=921600
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_DM_SERIAL=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_MTK_SERIAL=y
CONFIG_USB=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MT85XX=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="lidar-mainline"
# Same IDs as Kaeru LK fastboot, so hosts reuse the driver already bound to it
CONFIG_USB_GADGET_VENDOR_NUM=0x0bb4
CONFIG_USB_GADGET_PRODUCT_NUM=0x0c01
CONFIG_WDT=y
# CONFIG_WATCHDOG_AUTOSTART is not set
CONFIG_WDT_MTK=y
