# SPDX-License-Identifier: GPL-2.0-only
# Kernel config fragment for Amazon Echo Dot 3rd gen Refresh (crumpet, MT8516).
# For the O=crumpet build build.sh stacks lidar.config -> donut.config ->
# crumpet.config (mirroring the overlay sync), so this file rides on the
# family baseline: the same lines as donut.config plus the crumpet deltas,
# each marked "# crumpet:", and explicit overrides where a donut line must
# fall off (the merge is additive, so an omitted line would not drop it).
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT8516=y
CONFIG_PINCTRL_MT8516=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_I2C_MT65XX=y
CONFIG_MMC_MTK=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MTK_TIMER=y
CONFIG_PWM_MEDIATEK=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_MTK_THERMAL=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_INVENTRA_DMA=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
# no RT5738/RT5739 buck on this board family — explicit off (lidar.config
# sets =y and the merge is additive, so an omitted line would not drop it)
# CONFIG_REGULATOR_RT5739 is not set
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_IS31FL32XX=y
CONFIG_SENSORS_TMP108=y
CONFIG_SENSORS_LM75=y
# inherited from the donut baseline (ti,tmp103); harmless if the crumpet DT
# has no tmp103 nodes — driver builds, matches nothing
CONFIG_SENSORS_TMP103=y
CONFIG_MCP4531=y
# tsl2572 light/prox -> mainline tsl2772 driver (on crumpet's i2c list per
# plan Task 6, like donut); lidar's TSL2540 is absent (explicit off for the
# same additive-merge reason)
CONFIG_TSL2772=m
# CONFIG_TSL2540 is not set
# crumpet: OPT3001 ambient light sensor on i2c (plan Task 6 device list) —
# v7.3 symbol "config OPT3001" at drivers/iio/light/Kconfig:495
# (depends on I2C; IIO=y and I2C=y already come from arm64 defconfig)
CONFIG_OPT3001=m
# crumpet: raw NAND — MT8516 NFI controller + its hardware ECC engine, =y
# not =m so the C3 boot gate's root storage driver is builtin-capable.
# v7.3 spellings: the ECC engine symbol is CONFIG_MTD_NAND_ECC_MEDIATEK
# (drivers/mtd/nand/Kconfig:56; its object is ecc-mtk.o per
# drivers/mtd/nand/Makefile:5 — the symbol is NOT "MTD_NAND_ECC_MTK"); the
# controller is CONFIG_MTD_NAND_MTK (drivers/mtd/nand/raw/Kconfig:315, inside
# `if MTD_RAW_NAND`, depends on the ECC engine symbol). MTD_RAW_NAND=y and
# MTD_BLOCK=y come from arm64 defconfig (defconfig:294/283).
CONFIG_MTD=y
CONFIG_MTD_NAND_ECC_MEDIATEK=y
CONFIG_MTD_NAND_MTK=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_BT=m
CONFIG_BT_MTKSDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_MT8516=m
# the lidar machine driver stays enabled: its module simply does not match
# the crumpet DT, and keeping it lets future lidar.config lines apply as-is
# (it also keeps selecting ADC3XXX/AIC32X4_I2C, so no "not set" line for
# those would ever stick)
CONFIG_SND_SOC_MT8516_AMAZON_LIDAR=m
# crumpet: the donut machine driver is dropped — donut.config (merged below
# this fragment) carries CONFIG_SND_SOC_MT8516_AMAZON_DONUT=m
# (donut-linux/sound/soc/mediatek/Kconfig:390), and the additive merge only
# drops it via an explicit override (same mechanics as RT5739/TSL2540 above).
# The crumpet card (mediatek,mt8516-soc-card) machine driver symbol
# SND_SOC_MT8516_AMAZON_CRUMPET lands with stretch T10 — omit until then.
# CONFIG_SND_SOC_MT8516_AMAZON_DONUT is not set
# crumpet: the TAS5770 and AIC3101 codec drivers are a T9 stretch
# (reference/crumpet-codec-deltas.md): TAS2770=m stays from the donut.config
# baseline and SND_SOC_TLV320AIC31XX=m is select-forced by arm64 defconfig's
# SND_SOC_FSL_ASOC_CARD=m (sound/soc/fsl/Kconfig:323) — both would never stick
# as "not set", so this fragment carries no lines for them (until T9 adds the
# ti,tas5770 of_match and the ti,tlv320aic3101 ID entry they bind nothing).
CONFIG_SND_SOC_TLV320ADC3XXX=m
# integrated codec of the SoC + jack detection of the Amazon variant: the
# shipped crumpet card keeps the INT ADDA -> mt8167-codec link (audio
# forensics §2) and plan Task 6 wires integrated-codec/ACCDET via the shared
# donut port, so both stay from the baseline for the T10 machine driver.
# Overlay-provided symbols (donut-linux sound/soc/codecs + drivers/extcon),
# present in the merged tree through the donut overlay pass.
CONFIG_SND_SOC_MT8167_CODEC=m
CONFIG_EXTCON_MT8167_ACCDET=m
# snd-aloop carries the speaker mix to lidar-dsp (dsp feature)
CONFIG_SND_ALOOP=m
CONFIG_RESET_GPIO=y

# Trim arm64 defconfig to this board: other platforms, PCI, graphics, media
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# CONFIG_PCI is not set
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_CAN is not set
# CONFIG_STAGING is not set
# Previous boot's console and oops log in RAM (no UART RX on this board);
# ramoops area 0x5f000000+1M with 0x20000/0x80000/0x20000 (rec/con/pmsg)
# (crumpet DTS reserved-memory node, mt8516-amazon-crumpet.dts)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=10
# USB speakerphone: USB Audio Class 2 gadget function (tools/lidar-usbaudio.sh)
CONFIG_USB_CONFIGFS_F_UAC2=y
# ext4 root filesystem and FAT/extlinux partitions for the test image
CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
# firmware only from /lib/firmware, no sysfs fallback
# CONFIG_FW_LOADER_USER_HELPER is not set
