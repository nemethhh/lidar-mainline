/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Amazon Echo Dot (3rd generation), "donut".
 *
 * U-Boot is the payload of an Android boot image that the stock Amazon LK
 * loads (deploy variant per the M0 evidence: boot slot or swdl). The
 * operating system lives in the ext4 filesystem on the userdata partition
 * of the eMMC and is described by /boot/extlinux/extlinux.conf there.
 *
 * Unlike lidar there is no A/B fallback: the boot slots stay stock Fire OS
 * (spec §5.2), so a failed mainline boot never flips a slot. While
 * upgrade_available is 1 every boot increments bootcount; past bootlimit
 * U-Boot runs altbootcmd, which disarms the counter and stops in USB
 * fastboot. Userspace confirms a good boot with
 *   fw_setenv upgrade_available 0; fw_setenv bootcount 0
 *
 * Holding Volume Up at power-on enters USB fastboot (the TM4/TM5 USB pads).
 * Holding Volume Down switches the console to the USB CDC ACM serial
 * gadget and waits for a USB host, then continues booting - the console
 * without test-pad UART wiring. The switch is volatile: the environment
 * is only saved by the bootcount machinery (before bootcmd) and by
 * altbootcmd, never by bootcmd itself; after enabling the ACM console,
 * `saveenv` would persist it into the next boot, so don't (or run
 * donut_console_serial first).
 *
 * The Wi-Fi MAC is not an environment variable: amazon_idme.c copies it
 * from the /idme node LK adds to the devicetree into local-mac-address of
 * the Wi-Fi node of the OS devicetree (mmc@11170000/wifi@1).
 *
 * Boot state (upgrade_available, bootcount) is stored in this
 * environment, in the two 64 KiB copies at the top of the "misc"
 * partition (Amazon only uses misc's first 6 KiB).
 */

kernel_addr_r=0x44000000
kernel_comp_addr_r=0x50000000
kernel_comp_size=0x04000000
fdt_addr_r=0x4f000000
fdtoverlay_addr_r=0x4f100000
/* LK's devicetree (read for IDME) sits at 0x4e000000-0x4e080000: keep it free */
pxefile_addr_r=0x4e100000
ramdisk_addr_r=0x54000000

fdtfile=mediatek/mt8516-amazon-donut.dtb

bootlimit=3
upgrade_available=0

donut_console_serial=
	setenv stdin serial;
	setenv stdout serial;
	setenv stderr serial

donut_fastboot=
	run donut_console_serial;
	echo "donut: entering USB fastboot";
	fastboot usb 0

donut_usb_console=
	echo "donut: USB ACM console, waiting for a USB host";
	setenv stdin serial,usbacm;
	setenv stdout serial,usbacm;
	setenv stderr serial,usbacm

donut_boot=
	if part number mmc 0 userdata donut_part; then
		echo "donut: booting extlinux (mmc 0:${donut_part})";
		sysboot mmc 0:${donut_part} any ${pxefile_addr_r}
			/boot/extlinux/extlinux.conf;
	fi;
	echo "donut: no extlinux boot from userdata"

bootcmd=
	if button volume_up; then
		run donut_fastboot;
	fi;
	if button volume_down; then
		run donut_usb_console;
	fi;
	run donut_boot;
	run donut_fastboot

altbootcmd=
	echo "donut: bootlimit exceeded, stopping in fastboot (slots stay stock)";
	setenv upgrade_available 0;
	setenv bootcount 0;
	saveenv;
	run donut_fastboot
